# Copy to .env and uncomment only the settings you need.
# Model setup and data access: docs/model-access.md
# Exported variables take priority over .env.

# Inference (separate from your trace-platform credentials).
# GPT 5.6 Luna is the default.
# Full model string: openai/azure/openai/gpt-5.6-luna (requires its gateway).
# COMPASS_MODEL=
# COMPASS_API_KEY=
# Set only for a custom inference endpoint.
# Remove old endpoint overrides when switching providers; see docs/model-access.md.
# COMPASS_API_BASE=

# Optional sentiment screening: docs/compass-signals.md#user-sentiment
# Set compass_signals.user_sentiment.api_key_env to DECISIONS_API_KEY in YAML.
# DECISIONS_API_KEY=

# Braintrust: docs/sources/braintrust.md
# BRAINTRUST_API_KEY=
# BRAINTRUST_API_URL=
# Organization name enables links back to Braintrust; app URL is optional.
# BRAINTRUST_ORG_NAME=
# BRAINTRUST_APP_URL=

# LangSmith: docs/sources/langsmith.md
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
# LANGSMITH_WORKSPACE_ID=

# Compass execution telemetry (separate from trace-source access).
# Root metadata identifies the input corpus; model/tool spans retain execution content.
# Set both key and project to enable export. Endpoint defaults to https://api.smith.langchain.com.
# COMPASS_TELEMETRY_LANGSMITH_API_KEY=
# COMPASS_TELEMETRY_LANGSMITH_PROJECT=compass-dogfood
# COMPASS_TELEMETRY_LANGSMITH_ENDPOINT=
# COMPASS_TELEMETRY_LANGSMITH_WORKSPACE_ID=
# Optional tags on the trace of a Compass run
# COMPASS_TELEMETRY_LANGSMITH_TAGS=development,experiment-a

# Langfuse: docs/sources/langfuse.md
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# MLflow: docs/sources/mlflow.md
# MLFLOW_TRACKING_URI=
# Use a bearer token or a username/password pair.
# MLFLOW_TRACKING_TOKEN=
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# NeMo Platform Intake: docs/sources/intake.md
# NMP_ACCESS_TOKEN=

# Internal release publishing only: DEVELOPMENT.md
# ARTIFACTORY_PYPI_URL=
# ARTIFACTORY_TOKEN=
