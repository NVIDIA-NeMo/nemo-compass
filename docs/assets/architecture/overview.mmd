---
config: {"startOnLoad":false,"securityLevel":"strict","theme":"base","htmlLabels":false,"fontFamily":"Helvetica Neue, Arial, sans-serif","themeVariables":{"primaryColor":"#f0ecff","primaryTextColor":"#23243c","primaryBorderColor":"#9b8ade","lineColor":"#8c80bd","secondaryColor":"#dff4eb","tertiaryColor":"#ffffff","edgeLabelBackground":"#f7f8fc","clusterBkg":"#f5f2ff","clusterBorder":"#ddd5f3","fontSize":"20px"},"flowchart":{"curve":"basis","nodeSpacing":20,"rankSpacing":28,"padding":14,"subGraphTitleMargin":{"top":12,"bottom":24}},"themeCSS":".node rect { rx: 12px; ry: 12px; } .cluster rect { rx: 16px; ry: 16px; } .cluster-label text { font-weight: 600; } .node.dark .label text, .node.dark .label tspan { fill: #ffffff !important; }"}
---
%% Rendered with the Mermaid configuration and palette from uPages.
flowchart LR
  H["Existing insights"]:::faint --> I["Insight<br/>compilation"]:::dark
  subgraph LOADERS["Trace loaders"]
    LS["LangSmith"]
    LF["Langfuse"]
    BT["Braintrust"]
    ML["MLflow"]
    OT["Other"]:::faint
  end
  LS & LF & BT & ML & OT --> T["Normalized<br/>trace snapshot"]:::dark
  subgraph SIGNALS["Compass Signals"]
    A["Ethos divergence"]
    B["User sentiment"]
    C["Grader failures"]
    D["Tool issues"]
    E["Anomalies & patterns"]
  end
  T --> A & B & C & D & E
  A & B & C & D & E --> P["Candidate<br/>problems"]
  P --> V["Code validation<br/>(optional)"]:::faint
  V --> I
  I --> O["Ranked insights<br/>with trace references"]:::mint

  classDef default fill:#f0ecff,stroke:#9b8ade,color:#23243c,stroke-width:1.5px;
  classDef dark fill:#393254,stroke:#393254,color:#ffffff;
  classDef mint fill:#dff4eb,stroke:#78bba4,color:#245e4c;
  classDef faint fill:#ffffff,stroke:#c9c7d6,color:#626578,stroke-dasharray:5 4;
